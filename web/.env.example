# Canonical origin used for sitemap.xml, robots.txt and social-card URLs.
# Without it, builds fall back to Vercel's project URL, then to localhost.
NEXT_PUBLIC_SITE_URL=https://vaaca.org

# Signs the staff session cookie. Required in production; use 32+ random chars.
SESSION_SECRET=

# Optional: where the JSON data store lives (defaults to ./data).
# Serverless filesystems are ephemeral — point this at a persistent volume,
# or replace src/lib/server/store.ts with a database client.
# VAACA_DATA_DIR=/var/lib/vaaca

# Optional one-time seed for the first staff account. Prefer `npm run staff:add`.
# STAFF_SEED_EMAIL=secretariat@vaaca.org
# STAFF_SEED_PASSWORD=
